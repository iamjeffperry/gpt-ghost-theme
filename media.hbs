{{!< default}}

<main class="gh-main gh-outer mf-type-archive">
    <section class="gh-archive gh-inner mf-type-archive-header">
        <div class="gh-archive-inner">
            <header class="gh-archive-wrapper">
                <h1 class="gh-article-title is-title">{{#if @custom.media_label}}{{@custom.media_label}}{{else}}{{t "Media"}}{{/if}}</h1>
                <p class="gh-article-excerpt is-body">{{t "Podcasts, videos, and other things worth watching or listening to."}}</p>
            </header>
        </div>
    </section>

    {{> "channel-feed"}}
</main>
