{{!< default}}

<style>
    .gh-archive-page {
        padding-top: clamp(2.5rem, 6vw, 5rem);
        padding-bottom: clamp(4rem, 8vw, 8rem);
    }

    .gh-archive-header {
        max-width: 760px;
        margin-bottom: clamp(2rem, 5vw, 4rem);
    }

    .gh-archive-kicker {
        margin: 0 0 0.75rem;
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0.6;
    }

    .gh-archive-title {
        margin: 0;
        font-size: clamp(3.2rem, 6vw, 5.6rem);
        line-height: 1;
        letter-spacing: -0.04em;
    }

    .gh-archive-description {
        max-width: 680px;
        margin: 1.25rem 0 0;
        font-size: 1.8rem;
        line-height: 1.5;
        opacity: 0.72;
    }

    /*
     * Archive-specific reset:
     * Source's default list-feed styles can add their own borders/spacing.
     * The homepage stream already supplies the separator through .jp-entry,
     * so disable any extra card borders here and then restore exactly one
     * bottom rule per entry.
     */
    .gh-archive-page .jp-stream > .gh-card {
        border-top: 0 !important;
        border-right: 0 !important;
        border-left: 0 !important;
        border-bottom: 1px solid rgba(0, 0, 0, 0.16) !important;
        box-shadow: none !important;
    }

    .gh-archive-page .jp-stream > .gh-card + .gh-card {
        border-top: 0 !important;
        margin-top: 0 !important;
    }

    .gh-archive-page .jp-stream > .gh-card::before,
    .gh-archive-page .jp-stream > .gh-card::after {
        display: none !important;
        content: none !important;
    }

    .has-light-text .gh-archive-page .jp-stream > .gh-card {
        border-bottom-color: rgba(255, 255, 255, 0.2) !important;
    }
</style>

<main class="gh-archive-page gh-outer">
    <div class="gh-inner">

        <header class="gh-archive-header">
            <p class="gh-archive-kicker">Archive</p>
            <h1 class="gh-archive-title is-title">Everything, newest to oldest.</h1>
            <p class="gh-archive-description is-body">
                A chronological archive of posts, links, notes, images, and media published on {{@site.title}}.
            </p>
        </header>

    </div>

    {{!-- Use the exact same stream structure/classes as the homepage. --}}
    <section class="gh-container jp-stream-container gh-outer">
        <div class="gh-container-inner gh-inner">
            <main class="gh-main jp-stream-main">
                <div class="gh-feed jp-stream">
                    {{#get "posts" include="authors,tags" limit="all" order="published_at desc"}}
                        {{#foreach posts}}
                            {{> "post-card" lazyLoad=true}}
                        {{/foreach}}
                    {{/get}}
                </div>
            </main>
        </div>
    </section>
</main>
