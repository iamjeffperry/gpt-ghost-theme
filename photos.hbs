{{!< default}}

<main class="gh-main gh-outer mf-type-archive">
    <section class="gh-archive gh-inner mf-type-archive-header">
        <div class="gh-archive-inner">
            <header class="gh-archive-wrapper">
                <h1 class="gh-article-title is-title">{{#if @custom.photo_label}}{{@custom.photo_label}}{{else}}{{t "Photos"}}{{/if}}</h1>
                <p class="gh-article-excerpt is-body">{{t "Photographs, illustrations, and visual stories."}}</p>
            </header>
        </div>
    </section>

    {{> "channel-feed"}}
</main>
