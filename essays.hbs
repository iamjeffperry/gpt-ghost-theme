{{!< default}}

<main class="gh-main gh-outer mf-type-archive">
    <section class="gh-archive gh-inner mf-type-archive-header">
        <div class="gh-archive-inner">
            <header class="gh-archive-wrapper">
                <h1 class="gh-article-title is-title">{{#if @custom.essay_label}}{{@custom.essay_label}}{{else}}{{t "Essays"}}{{/if}}</h1>
                <p class="gh-article-excerpt is-body">{{t "Longer writing, ideas, and pieces worth spending a little more time with."}}</p>
            </header>
        </div>
    </section>

    {{> "channel-feed"}}
</main>
