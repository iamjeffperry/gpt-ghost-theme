{{!< default}}

<main class="gh-main gh-outer mf-type-archive">
    <section class="gh-archive gh-inner mf-type-archive-header">
        <div class="gh-archive-inner">
            <header class="gh-archive-wrapper">
                <h1 class="gh-article-title is-title">{{#if @custom.link_label}}{{@custom.link_label}}{{else}}{{t "Links"}}{{/if}}</h1>
                <p class="gh-article-excerpt is-body">{{t "Interesting things from around the web, with context from this publication."}}</p>
            </header>
        </div>
    </section>

    {{> "channel-feed"}}
</main>
