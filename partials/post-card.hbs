<article
    class="gh-card mf-entry{{#if featuredCard}} is-featured{{/if}}{{#if feature_image}} has-feature-image{{/if}} {{post_class}}{{#has tag="#essay"}} is-essay{{/has}}{{#has tag="#note,#micro"}} is-short is-note{{/has}}{{#has tag="#photo,#image"}} is-image is-photo{{/has}}{{#has tag="#link"}} is-link{{/has}}{{#has tag="#media"}} is-media{{/has}}{{#has tag="#quote"}} is-quote{{/has}}{{#unless @custom.show_images_in_feed}} no-image{{/unless}}"
    style="
        {{#if primary_tag.accent_color}}--post-type-color: {{primary_tag.accent_color}};{{/if}}
        {{#foreach tags visibility="all"}}
            {{#match name "#essay"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#note"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#micro"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#photo"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#image"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#link"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#media"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#quote"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
        {{/foreach}}
    "
>
    <div class="mf-entry-meta">
        {{#if featuredCard}}
            <span class="mf-featured-badge"><span aria-hidden="true">★</span> Featured</span>
        {{/if}}

        {{#has tag="#essay,#note,#micro,#photo,#image,#link,#media,#quote"}}
            <span class="mf-entry-kind">
                <span class="mf-entry-kind-icon" aria-hidden="true">
                    {{#has tag="#note,#micro"}}
                        {{> "post-type-icon" icon=@custom.note_icon}}
                    {{else}}
                        {{#has tag="#link"}}
                            {{> "post-type-icon" icon=@custom.link_icon}}
                        {{else}}
                            {{#has tag="#media"}}
                                {{> "post-type-icon" icon=@custom.media_icon}}
                            {{else}}
                                {{#has tag="#photo,#image"}}
                                    {{> "post-type-icon" icon=@custom.photo_icon}}
                                {{else}}
                                    {{#has tag="#quote"}}
                                        {{> "post-type-icon" icon=@custom.quote_icon}}
                                    {{else}}
                                        {{> "post-type-icon" icon=@custom.essay_icon}}
                                    {{/has}}
                                {{/has}}
                            {{/has}}
                        {{/has}}
                    {{/has}}
                </span>
                <span class="mf-entry-kind-label">
                    {{#has tag="#note,#micro"}}{{#if @custom.note_label}}{{@custom.note_label}}{{else}}Note{{/if}}
                    {{else}}{{#has tag="#photo,#image"}}{{#if @custom.photo_label}}{{@custom.photo_label}}{{else}}Photo{{/if}}
                    {{else}}{{#has tag="#link"}}{{#if @custom.link_label}}{{@custom.link_label}}{{else}}Link{{/if}}
                    {{else}}{{#has tag="#media"}}{{#if @custom.media_label}}{{@custom.media_label}}{{else}}Media{{/if}}
                    {{else}}{{#has tag="#quote"}}{{#if @custom.quote_label}}{{@custom.quote_label}}{{else}}Quote{{/if}}
                    {{else}}{{#if @custom.essay_label}}{{@custom.essay_label}}{{else}}Essay{{/if}}{{/has}}{{/has}}{{/has}}{{/has}}{{/has}}
                </span>
            </span>
        {{else}}
            {{#if primary_tag}}
                <span class="mf-entry-kind">
                    <span class="mf-entry-kind-icon" aria-hidden="true">
                        {{> "post-type-icon" icon="Tag"}}
                    </span>
                    <span class="mf-entry-kind-label">{{primary_tag.name}}</span>
                </span>
            {{/if}}
        {{/has}}

    </div>

    <div class="mf-entry-layout">
        <div class="mf-entry-copy">
            {{#has tag="#note,#micro"}}
                <div class="mf-entry-note mf-entry-content is-body">
                    {{content}}
                </div>

            {{else}}
                {{#has tag="#quote"}}
                    <div class="mf-entry-quote mf-entry-content is-body">
                        {{content}}
                    </div>

                {{else}}
                    {{#has tag="#link"}}
                    <h2 class="mf-entry-title is-title">
                        <a class="mf-entry-external-title" href="{{url}}" data-local-url="{{url}}">{{title}}</a>
                    </h2>
                    <div class="mf-entry-content mf-entry-link-content is-body">
                        {{content}}
                    </div>

                {{else}}
                    <h2 class="mf-entry-title is-title"><a href="{{url}}">{{title}}</a></h2>

                    {{#has tag="#media"}}
                        <div class="mf-entry-content mf-entry-media-content is-body">
                            {{content}}
                        </div>
                    {{else}}
                        {{#has tag="#photo,#image"}}
                            <div class="mf-entry-content mf-entry-image-content is-body">
                                {{content}}
                            </div>
                        {{else}}
                            {{#if custom_excerpt}}
                                <p class="mf-entry-excerpt is-body">{{custom_excerpt}}</p>
                            {{else}}
                                {{#if excerpt}}
                                    <p class="mf-entry-excerpt is-body">{{excerpt words="28"}}</p>
                                {{/if}}
                            {{/if}}
                    {{/has}}
                {{/has}}
            {{/has}}
                {{/has}}
            {{/has}}

            <a class="mf-entry-time" href="{{url}}" aria-label="Permalink to {{title}}">
                <time datetime="{{date format="YYYY-MM-DDTHH:mm:ssZ"}}">{{date format="MMM D, YYYY"}}</time>
                {{#unless featuredCard}}
                    {{#has tag="#note,#micro,#link,#media,#photo,#image,#quote"}}{{else}}{{#if reading_time}}<span class="mf-entry-reading-time"> · {{reading_time minute="1 min read" minutes="% min read"}}</span>{{/if}}{{/has}}
                {{/unless}}
                {{#if featuredCard}}{{#if reading_time}}<span class="mf-entry-reading-time"> · {{reading_time minute="1 min read" minutes="% min read"}}</span>{{/if}}{{/if}}
            </a>
        </div>

        {{#if feature_image}}
            <a class="mf-entry-image-link" href="{{url}}">
                <figure class="mf-entry-image">
                    <img
                        srcset="{{img_url feature_image size="s" format="webp"}} 320w,
                                {{img_url feature_image size="m" format="webp"}} 600w,
                                {{img_url feature_image size="l" format="webp"}} 960w,
                                {{img_url feature_image size="xl" format="webp"}} 1200w"
                        sizes="(max-width: 767px) 100vw, 420px"
                        src="{{img_url feature_image size="m"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        decoding="async"
                        {{#if featuredCard}}fetchpriority="high"{{else}}{{#if lazyLoad}}loading="lazy"{{/if}}{{/if}}
                    >
                </figure>
            </a>
        {{/if}}
    </div>
</article>
