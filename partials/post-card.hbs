<article
    class="gh-card jp-entry{{#if featuredCard}} is-featured{{/if}}{{#if feature_image}} has-feature-image{{/if}} {{post_class}}{{#has tag="#micro"}} is-short{{/has}}{{#has tag="#image"}} is-image{{/has}}{{#has tag="#link"}} is-link{{/has}}{{#has tag="#media"}} is-media{{/has}}{{#unless @custom.show_images_in_feed}} no-image{{/unless}}"
    style="
        {{#if primary_tag.accent_color}}--post-type-color: {{primary_tag.accent_color}};{{/if}}
        {{#foreach tags visibility="all"}}
            {{#match name "#micro"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#image"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#link"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#media"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
        {{/foreach}}
    "
>
    <div class="jp-entry-meta">
        {{#if featuredCard}}
            <span class="jp-featured-badge"><span aria-hidden="true">★</span> Featured</span>
        {{/if}}

        <span class="jp-entry-kind">
            <span class="jp-entry-kind-icon" aria-hidden="true">
                {{#has tag="#micro"}}
                    <svg viewBox="0 0 24 24" role="img"><circle class="jp-icon-fill" cx="12" cy="12" r="5"/></svg>
                {{else}}
                    {{#has tag="#link"}}
                        <svg viewBox="0 0 24 24" role="img"><path d="M7 17 17 7M9 7h8v8"/></svg>
                    {{else}}
                        {{#has tag="#media"}}
                            <svg viewBox="0 0 24 24" role="img"><path class="jp-icon-fill" d="m8 5 11 7-11 7z"/></svg>
                        {{else}}
                            {{#has tag="#image"}}
                                <svg viewBox="0 0 24 24" role="img"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="m6 16 4-4 3 3 2-2 3 3"/><circle cx="9" cy="9" r="1"/></svg>
                            {{else}}
                                <svg viewBox="0 0 24 24" role="img"><path class="jp-icon-fill" d="m12 2.8 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>
                            {{/has}}
                        {{/has}}
                    {{/has}}
                {{/has}}
            </span>
            <span class="jp-entry-kind-label">
                {{#has tag="#micro"}}Note
                {{else}}{{#has tag="#image"}}Photo
                {{else}}{{#has tag="#link"}}Link
                {{else}}{{#has tag="#media"}}Media
                {{else}}Essay{{/has}}{{/has}}{{/has}}{{/has}}
            </span>
        </span>

    </div>

    <div class="jp-entry-layout">
        <div class="jp-entry-copy">
            {{#has tag="#micro"}}
                <div class="jp-entry-note jp-entry-content is-body">
                    {{content}}
                </div>

            {{else}}
                {{#has tag="#link"}}
                    <h2 class="jp-entry-title is-title">
                        <a class="jp-entry-external-title" href="{{url}}" data-local-url="{{url}}">{{title}}</a>
                    </h2>
                    <a class="jp-entry-link-source" href="{{url}}" data-local-url="{{url}}" aria-label="Open linked website"></a>
                    <div class="jp-entry-content jp-entry-link-content is-body">
                        {{content}}
                    </div>

                {{else}}
                    <h2 class="jp-entry-title is-title"><a href="{{url}}">{{title}}</a></h2>

                    {{#has tag="#media"}}
                        <div class="jp-entry-content jp-entry-media-content is-body">
                            {{content}}
                        </div>
                    {{else}}
                        {{#has tag="#image"}}
                            <div class="jp-entry-content jp-entry-image-content is-body">
                                {{content}}
                            </div>
                        {{else}}
                            {{#if custom_excerpt}}
                                <p class="jp-entry-excerpt is-body">{{custom_excerpt}}</p>
                            {{else}}
                                {{#if excerpt}}
                                    <p class="jp-entry-excerpt is-body">{{excerpt words="45"}}</p>
                                {{/if}}
                            {{/if}}
                        {{/has}}
                    {{/has}}
                {{/has}}
            {{/has}}

            <a class="jp-entry-time" href="{{url}}" aria-label="Permalink to {{title}}">
                <time datetime="{{date format="YYYY-MM-DDTHH:mm:ssZ"}}">{{date format="MMM D, YYYY"}}</time>
                {{#unless featuredCard}}
                    {{#has tag="#micro,#link,#media,#image"}}{{else}}{{#if reading_time}}<span class="jp-entry-reading-time"> · {{reading_time minute="1 min read" minutes="% min read"}}</span>{{/if}}{{/has}}
                {{/unless}}
                {{#if featuredCard}}{{#if reading_time}}<span class="jp-entry-reading-time"> · {{reading_time minute="1 min read" minutes="% min read"}}</span>{{/if}}{{/if}}
            </a>
        </div>

        {{#if feature_image}}
            <a class="jp-entry-image-link" href="{{url}}">
                <figure class="jp-entry-image">
                    <img
                        srcset="{{img_url feature_image size="s" format="webp"}} 320w,
                                {{img_url feature_image size="m" format="webp"}} 600w,
                                {{img_url feature_image size="l" format="webp"}} 960w,
                                {{img_url feature_image size="xl" format="webp"}} 1200w"
                        sizes="(max-width: 767px) 100vw, 420px"
                        src="{{img_url feature_image size="m"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        decoding="async"
                        {{#if featuredCard}}fetchpriority="high"{{else}}{{#if lazyLoad}}loading="lazy"{{/if}}{{/if}}
                    >
                </figure>
            </a>
        {{/if}}
    </div>
</article>
