{{!--
    Mixed-format theme chronological stream.

    Parameters:
    * feed (index, home, archive)
    * showTitle (true, false)
    * showSidebar (true, false)
--}}

<section class="gh-container mf-stream-container gh-outer">
    <div class="gh-container-inner gh-inner">

        <div class="gh-main mf-stream-main">
            <div class="gh-feed mf-stream">

                {{!-- Homepage:
                      routes.yaml orders featured posts first, then all posts by date.
                      The newest featured post becomes the hero; any additional featured
                      posts remain ordinary cards in Ghost's native paginated collection. --}}
                {{#match feed "home"}}
                    {{#foreach posts}}
                        {{#if @first}}
                            {{#if featured}}
                                {{> "post-card" lazyLoad=false featuredCard=true}}
                            {{else}}
                                {{> "post-card" lazyLoad=false}}
                            {{/if}}
                        {{else}}
                            {{> "post-card" lazyLoad=true}}
                        {{/if}}
                    {{else}}
                        <p class="mf-empty-state is-body">{{t "No posts have been published yet."}}</p>
                    {{/foreach}}
                {{/match}}

                {{!-- Main index / paginated archive. --}}
                {{#match feed "index"}}
                    {{#foreach posts}}
                        {{> "post-card" lazyLoad=true}}
                    {{/foreach}}
                {{/match}}

                {{!-- Tag and author pages. --}}
                {{#match feed "archive"}}
                    {{#foreach posts}}
                        {{> "post-card" lazyLoad=true}}
                    {{/foreach}}
                {{/match}}

            </div>

            {{#match pagination.pages ">" 1}}
                {{pagination}}
            {{/match}}
        </div>

    </div>
</section>
