<header id="gh-navigation" class="gh-navigation is-left-logo{{#match @custom.header_and_footer_color "Accent color"}} has-accent-color{{/match}} gh-outer">
    <div class="gh-navigation-inner gh-inner">

        <div class="gh-navigation-brand">
            <div class="mf-navigation-identity">
                {{#if @site.icon}}
                    <a class="mf-navigation-icon" href="{{@site.url}}" aria-label="{{@site.title}} home">
                        <img src="{{@site.icon}}" alt="">
                    </a>
                {{/if}}
                <a class="gh-navigation-logo is-title" href="{{@site.url}}">{{@site.title}}</a>
                {{#if @site.description}}
                    <span class="mf-navigation-description is-body">
                        {{@site.description}}
                    </span>
                {{/if}}
            </div>
            {{> "search-toggle"}}
            <button class="gh-burger gh-icon-button" aria-label="{{t "Menu"}}">
                {{> "icons/burger"}}
                {{> "icons/close"}}
            </button>
        </div>

        <nav class="gh-navigation-menu" aria-label="Primary navigation">
            {{navigation}}
        </nav>

        <div class="gh-navigation-actions">
            {{> "search-toggle"}}
            {{#if @site.members_enabled}}
                <div class="gh-navigation-members">
                    {{#if @member}}
                        <a class="gh-button" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
                    {{else}}
                        {{#unless @site.members_invite_only}}
                            {{#unless hideSubscribeButton}}
                                <a class="gh-button" href="#/portal/signup" data-portal="signup">{{t "Subscribe"}}</a>
                            {{/unless}}
                        {{/unless}}
                    {{/if}}
                </div>
            {{/if}}
        </div>

    </div>
</header>
