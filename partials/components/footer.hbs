<footer class="gh-footer jp-footer{{#match @custom.header_and_footer_color "Accent color"}} has-accent-color{{/match}}">

    <div class="jp-footer-subscribe-wrap gh-outer">
        <section class="jp-footer-subscribe gh-inner">
            <div class="jp-footer-subscribe-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img"><path d="M4 6.5h16v11H4z"/><path d="m4.7 7.2 7.3 5.7 7.3-5.7"/></svg>
            </div>

            <div class="jp-footer-subscribe-copy">
                <h2 class="jp-footer-subscribe-title is-title">Stay up to date</h2>
                <p class="jp-footer-subscribe-text is-body">
                    {{#if @site.description}}{{@site.description}}{{else}}New posts delivered directly to your inbox.{{/if}}
                </p>
            </div>

            <div class="jp-footer-subscribe-actions">
                {{#if @site.members_enabled}}
                    {{#unless @member}}
                        {{> "email-subscription" email_field_id="footer-email"}}
                    {{else}}
                        <a class="jp-rss-pill" href="{{@site.url}}/rss/" aria-label="Subscribe by RSS">
                            {{> "icons/rss"}}
                            <span>RSS Feed</span>
                        </a>
                    {{/unless}}
                {{else}}
                    <a class="jp-rss-pill" href="{{@site.url}}/rss/" aria-label="Subscribe by RSS">
                        {{> "icons/rss"}}
                        <span>RSS Feed</span>
                    </a>
                {{/if}}
            </div>
        </section>
    </div>

    <div class="jp-footer-band gh-outer">
        <div class="jp-footer-inner gh-inner">
            <div class="jp-footer-grid">
                <div class="jp-footer-about">
                    <a class="jp-footer-title is-title" href="{{@site.url}}">{{@site.title}}</a>
                    <p class="jp-footer-description is-body">
                        {{#if @site.description}}{{@site.description}}{{else}}A personal stream of things I write, notice, watch, and find interesting.{{/if}}
                    </p>
                    <p class="jp-footer-philosophy is-body">Independent publishing, delivered directly.</p>
                </div>

                <div class="jp-footer-explore">
                    <span class="jp-footer-heading">Explore</span>
                    <nav class="jp-footer-menu" aria-label="Footer navigation">
                        {{navigation}}
                    </nav>
                </div>

                <div class="jp-footer-follow">
                    <span class="jp-footer-heading">Follow</span>
                    <div class="jp-footer-socials">
                        {{#social_accounts @site}}
                            <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}" title="{{name}}">
                                {{#> (concat "icons/" type)}}
                                    <span>{{name}}</span>
                                {{/undefined}}
                            </a>
                        {{/social_accounts}}
                        <a class="is-rss" href="{{@site.url}}/rss/" aria-label="RSS" title="RSS">{{> "icons/rss"}}</a>
                    </div>
                </div>
            </div>

            <div class="jp-footer-bottom">
                <span>© {{date format="YYYY"}} {{@site.title}}</span>
                <span>Powered by Ghost.</span>
            </div>
        </div>
    </div>

</footer>
