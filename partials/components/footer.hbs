<footer class="gh-footer mf-footer{{#match @custom.header_and_footer_color "Accent color"}} has-accent-color{{/match}}">

    <div class="mf-footer-subscribe-wrap gh-outer">
        <section class="mf-footer-subscribe gh-inner">
            <div class="mf-footer-subscribe-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img"><path d="M4 6.5h16v11H4z"/><path d="m4.7 7.2 7.3 5.7 7.3-5.7"/></svg>
            </div>

            <div class="mf-footer-subscribe-copy">
                <h2 class="mf-footer-subscribe-title is-title">{{t "Stay up to date"}}</h2>
                <p class="mf-footer-subscribe-text is-body">
                    {{#if @site.description}}{{@site.description}}{{else}}{{t "New posts delivered directly to your inbox."}}{{/if}}
                </p>
            </div>

            <div class="mf-footer-subscribe-actions">
                {{#if @site.members_enabled}}
                    {{#unless @member}}
                        {{> "email-subscription" email_field_id="footer-email"}}
                    {{else}}
                        <a class="mf-rss-pill" href="{{@site.url}}/rss/" aria-label="{{t "Subscribe by RSS"}}">
                            {{> "icons/rss"}}
                            <span>{{t "RSS Feed"}}</span>
                        </a>
                    {{/unless}}
                {{else}}
                    <a class="mf-rss-pill" href="{{@site.url}}/rss/" aria-label="{{t "Subscribe by RSS"}}">
                        {{> "icons/rss"}}
                        <span>{{t "RSS Feed"}}</span>
                    </a>
                {{/if}}
            </div>
        </section>
    </div>

    <div class="mf-footer-band gh-outer">
        <div class="mf-footer-inner gh-inner">
            <div class="mf-footer-grid">
                <div class="mf-footer-about">
                    <a class="mf-footer-title is-title" href="{{@site.url}}">{{@site.title}}</a>
                    <p class="mf-footer-description is-body">
                        {{#if @site.description}}{{@site.description}}{{else}}{{t "An independent stream of writing, links, notes, photos, and media."}}{{/if}}
                    </p>
                    <p class="mf-footer-philosophy is-body">{{t "Independent publishing, delivered directly."}}</p>
                </div>

                <div class="mf-footer-explore">
                    <span class="mf-footer-heading">{{t "Explore"}}</span>
                    <nav class="mf-footer-menu" aria-label="{{t "Footer navigation"}}">
                        {{navigation}}
                    </nav>
                </div>

                <div class="mf-footer-follow">
                    <span class="mf-footer-heading">{{t "Follow"}}</span>
                    <div class="mf-footer-socials">
                        {{#social_accounts @site}}
                            <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}" title="{{name}}">
                                {{#> (concat "icons/" type)}}
                                    <span>{{name}}</span>
                                {{/undefined}}
                            </a>
                        {{/social_accounts}}
                        <a class="is-rss" href="{{@site.url}}/rss/" aria-label="{{t "RSS"}}" title="{{t "RSS"}}">{{> "icons/rss"}}</a>
                    </div>
                </div>
            </div>

            <div class="mf-footer-bottom">
                <span>© {{date format="YYYY"}} {{@site.title}}</span>
                <span>{{t "Powered by Ghost"}}</span>
            </div>
        </div>
    </div>

</footer>
