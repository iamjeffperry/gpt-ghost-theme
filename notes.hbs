{{!< default}}

<main class="gh-main gh-outer mf-type-archive">
    <section class="gh-archive gh-inner mf-type-archive-header">
        <div class="gh-archive-inner">
            <header class="gh-archive-wrapper">
                <h1 class="gh-article-title is-title">{{#if @custom.note_label}}{{@custom.note_label}}{{else}}{{t "Notes"}}{{/if}}</h1>
                <p class="gh-article-excerpt is-body">{{t "Short thoughts, observations, and things that do not need to become full posts."}}</p>
            </header>
        </div>
    </section>

    {{> "channel-feed"}}
</main>
