{{!< default}}

<main class="gh-main gh-outer jp-type-archive">
    <section class="gh-archive gh-inner jp-type-archive-header">
        <div class="gh-archive-inner">
            <header class="gh-archive-wrapper">
                <h1 class="gh-article-title is-title">{{#if @custom.quote_label}}{{@custom.quote_label}}{{else}}Quotes{{/if}}</h1>
                <p class="gh-article-excerpt is-body">Words worth preserving, with room for context and response.</p>
            </header>
        </div>
    </section>

    <section class="gh-container jp-stream-container gh-outer">
        <div class="gh-container-inner gh-inner">
            <main class="gh-main jp-stream-main">
                <div class="gh-feed jp-stream">
                    {{#get "posts" filter="tag:hash-quote" include="authors,tags" limit="100"}}
                        {{#foreach posts}}
                            {{> "post-card" lazyLoad=true}}
                        {{/foreach}}
                    {{/get}}
                </div>
            </main>
        </div>
    </section>
</main>
