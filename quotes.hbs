{{!< default}}

<main class="gh-main gh-outer mf-type-archive">
    <section class="gh-archive gh-inner mf-type-archive-header">
        <div class="gh-archive-inner">
            <header class="gh-archive-wrapper">
                <h1 class="gh-article-title is-title">{{#if @custom.quote_label}}{{@custom.quote_label}}{{else}}{{t "Quotes"}}{{/if}}</h1>
                <p class="gh-article-excerpt is-body">{{t "Words worth preserving, with room for context and response."}}</p>
            </header>
        </div>
    </section>

    {{> "channel-feed"}}
</main>
